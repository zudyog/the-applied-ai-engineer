# ── OpenAI (Book 1 + Book 2) ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here

# ── Qdrant Cloud (Chapter 2) ──────────────────────────────────────────────────
# Create a free-tier cluster at cloud.qdrant.io, select asia-south1 (Mumbai).
QDRANT_URL=https://your-cluster-id.qdrant.cloud
QDRANT_API_KEY=your-qdrant-api-key

# ── Redis (Chapter 6 — memory, Chapter 7 — cache) ────────────────────────────
# Redis Cloud free tier works. Or run locally: redis-server
REDIS_URL=redis://default:your-password@your-redis-host:6379/0

# ── Rerank microservice (Chapter 4 + 9) ──────────────────────────────────────
# Required — this process has no in-process cross-encoder, it only calls this
# service (retrieval/rerank_client.py). It's a separate standalone project,
# ../shopbot-rerank/, not a subfolder of this one. Run it locally via Docker
# before starting the API:
#   cd ../shopbot-rerank && docker build -t shopbot-rerank . && docker run -p 8001:8001 shopbot-rerank
RERANK_URL=http://localhost:8001

# ── Google Sheets service account (Chapter 8 RAGAS Monday) ───────────────────
# Path to the JSON credentials file for gspread.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# ── MLflow tracking (Chapter 8 eval metrics + Chapter 9 API tracing) ──────────
# Start the server: docker compose up -d (this project's own docker-compose.yml)
# Leave unset to disable silently.
# MLFLOW_TRACKING_URI=http://localhost:5001
