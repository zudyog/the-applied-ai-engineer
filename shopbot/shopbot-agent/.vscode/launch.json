{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug retrieval",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/debug_retrieval.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Debug API (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["src.api:app", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "jinja": true
    }
  ]
}
